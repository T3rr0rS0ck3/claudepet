<Window x:Class="ClaudePet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Pet – Einstellungen"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <GroupBox Header="Claude Code">
            <StackPanel>
                <TextBlock x:Name="SetupStatusText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="ConnectButton" Content="Claude Code verbinden" Padding="10,3" Click="Connect_Click" />
                    <Button x:Name="DisconnectButton" Content="Trennen" Padding="10,3" Margin="8,0,0,0" Click="Disconnect_Click" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Claude starten">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Repo-Ordner" VerticalAlignment="Center"
                               ToolTip="Ordner, in dem alle Projekte liegen" />
                    <TextBox x:Name="ReposPathBox" Grid.Column="1" ToolTip="Ordner, in dem alle Projekte liegen" />
                    <Button Grid.Column="2" Content="…" Width="28" Margin="6,0,0,0" Click="BrowseRepos_Click" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Konsole" VerticalAlignment="Center" />
                    <ComboBox x:Name="TerminalBox" Grid.Column="1" />
                </Grid>
                <TextBlock x:Name="ClaudeStatusText" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Pet">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Größe" VerticalAlignment="Center" />
                    <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="2" Maximum="12" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0}x}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <CheckBox x:Name="AlwaysOnTopBox" Content="Immer im Vordergrund" />
                <CheckBox x:Name="AnimationsBox" Content="Animationen" />
                <CheckBox x:Name="WalkAroundBox" Content="Auf dem Desktop herumlaufen"
                          IsEnabled="{Binding IsChecked, ElementName=AnimationsBox}" />
                <CheckBox x:Name="AutostartBox" Content="Mit Windows starten" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Usage">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Aktualisierungsintervall (s)" VerticalAlignment="Center" />
                    <TextBox x:Name="IntervalBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Session-Warnschwellen (%)" VerticalAlignment="Center" />
                    <TextBox x:Name="SessionWarnBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wochen-Warnschwellen (%)" VerticalAlignment="Center" />
                    <TextBox x:Name="WeekWarnBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Zustandsgrenzen (%)" VerticalAlignment="Center"
                               ToolTip="normal, aufmerksam, nervös, besorgt, Panik, schlafen" />
                    <TextBox x:Name="MoodThresholdsBox" Grid.Column="1"
                             ToolTip="normal, aufmerksam, nervös, besorgt, Panik, schlafen" />
                </Grid>
                <TextBlock Text="Reihenfolge: normal, aufmerksam, nervös, besorgt, Panik, schlafen"
                           Foreground="Gray" FontSize="11" Margin="0,0,0,4" />
                <CheckBox x:Name="ForecastBox" Content="Prognose anzeigen" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Sprechblasen &amp; Benachrichtigungen">
            <StackPanel>
                <CheckBox x:Name="BubblesBox" Content="Sprechblasen anzeigen" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Anzeigedauer (s)" VerticalAlignment="Center" />
                    <TextBox x:Name="BubbleDurationBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Dein Name" VerticalAlignment="Center" />
                    <TextBox x:Name="NameBox" Grid.Column="1" />
                </Grid>
                <CheckBox x:Name="NotificationsBox" Content="Windows-Benachrichtigungen" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Texte bearbeiten…" Padding="10,3" Click="EditTexts_Click"
                            ToolTip="Öffnet settings.json; Änderungen werden automatisch übernommen." />
                    <Button Content="Test-Benachrichtigung" Padding="10,3" Margin="8,0,0,0" Click="TestNotification_Click" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Speichern" Width="100" Padding="0,4" IsDefault="True" Click="Save_Click" />
            <Button Content="Abbrechen" Width="100" Padding="0,4" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
