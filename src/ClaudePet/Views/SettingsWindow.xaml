<Window x:Class="ClaudePet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Pet – Einstellungen"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F5F4EF">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#77736B" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Same frame as the usage overlay; the shadow sits on its own layer so the text stays crisp -->
    <Grid Margin="10">
        <Border Background="#262624" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" />
            </Border.Effect>
        </Border>
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="12">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="18,12,18,10" Background="Transparent" Cursor="SizeAll"
              MouseLeftButtonDown="Title_MouseLeftButtonDown">
            <TextBlock Text="EINSTELLUNGEN" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14"
                       FontFamily="Consolas" HorizontalAlignment="Center" />
            <TextBlock Text="✕" Foreground="#77736B" FontSize="12" Cursor="Hand" HorizontalAlignment="Right"
                       VerticalAlignment="Center" MouseLeftButtonUp="Close_Click" ToolTip="Schließen" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="18,6,18,16">
            <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Speichern" Width="100" Padding="0,5" IsDefault="True" Click="Save_Click"
                        Style="{StaticResource PrimaryButton}" />
                <Button Content="Abbrechen" Width="100" Padding="0,5" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Height="1" Background="#3A3936" Margin="18,0" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18,0,8,0" Padding="0,0,10,0">
    <StackPanel Margin="0,4,0,0">
        <GroupBox Header="CLAUDE CODE">
            <StackPanel>
                <TextBlock x:Name="SetupStatusText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="ConnectButton" Content="Claude Code verbinden" Padding="10,3" Click="Connect_Click" />
                    <Button x:Name="DisconnectButton" Content="Trennen" Padding="10,3" Margin="8,0,0,0" Click="Disconnect_Click" />
                </StackPanel>
                <CheckBox x:Name="SessionMarksBox" Content="„?“ bei Fragen und Sprechblase wenn Claude fertig ist" Margin="0,8,0,4"
                          ToolTip="Trägt Hooks in die Claude-Code-Einstellungen ein (nur wenn verbunden). Ausschalten entfernt sie wieder." />
                <CheckBox x:Name="SessionPetsBox" Content="Baby-Pet für jede Claude-Session"
                          IsEnabled="{Binding IsChecked, ElementName=SessionMarksBox}"
                          ToolTip="Ein kleines Pet pro laufender Session folgt dem Pet und zeigt deren „?“." />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="CLAUDE STARTEN">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Repo-Ordner" VerticalAlignment="Center"
                               ToolTip="Ordner, in dem alle Projekte liegen" />
                    <TextBox x:Name="ReposPathBox" Grid.Column="1" ToolTip="Ordner, in dem alle Projekte liegen" />
                    <Button Grid.Column="2" Content="…" Width="32" Padding="0" Margin="6,0,0,0" Click="BrowseRepos_Click" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Claude öffnen in" VerticalAlignment="Center" />
                    <ComboBox x:Name="TerminalBox" Grid.Column="1" />
                </Grid>
                <CheckBox x:Name="GhostDragBox" Content="Pet mit linker Maustaste auf Explorer ziehen öffnet Claude dort" />
                <CheckBox x:Name="VoiceBox" Content="Sprachchat anbieten (Menüeintrag „Sprachchat starten…“)"
                          ToolTip="Nutzt das Sprachdiktat von Claude Code. Benötigt ein claude.ai-Konto und ein Mikrofon. Ausschalten schaltet auch das Diktat in Claude Code wieder ab." />
                <TextBlock x:Name="ClaudeStatusText" Style="{StaticResource Hint}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="PET">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Größe" VerticalAlignment="Center" />
                    <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="2" Maximum="12" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0}x}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Farbe" VerticalAlignment="Center" />
                    <Border x:Name="ColorPreview" Grid.Column="1" Width="24" Height="22" Margin="0,0,6,0"
                            BorderBrush="#4A4844" BorderThickness="1" CornerRadius="4" />
                    <TextBox x:Name="ColorBox" Grid.Column="2" MaxLength="7" TextChanged="ColorBox_TextChanged" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Wählen…" Padding="10,2" Click="PickColor_Click" />
                        <Button Content="Standard" Padding="10,2" Margin="6,0,0,0" Click="DefaultColor_Click" />
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="ClaudeMascotBox" Content="Claude-Maskottchen im Terminal in Pet-Farbe"
                          ToolTip="Legt ein eigenes Claude-Code-Theme an (themes\claudepet.json) und wählt es aus. Beim Ausschalten wird das vorherige Theme wiederhergestellt." />
                <CheckBox x:Name="AlwaysOnTopBox" Content="Immer im Vordergrund" />
                <CheckBox x:Name="AnimationsBox" Content="Animationen" />
                <CheckBox x:Name="WalkAroundBox" Content="Auf dem Desktop herumlaufen"
                          IsEnabled="{Binding IsChecked, ElementName=AnimationsBox}" />
                <CheckBox x:Name="CrossMonitorsBox" Content="Zwischen Monitoren wechseln"
                          ToolTip="Läuft oder hüpft dort zum Nachbarmonitor, wo sich die Monitore laut Windows-Anordnung berühren."
                          IsEnabled="{Binding IsChecked, ElementName=WalkAroundBox}" />
                <CheckBox x:Name="AutostartBox" Content="Mit Windows starten" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="USAGE">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Aktualisierungsintervall (s)" VerticalAlignment="Center" />
                    <TextBox x:Name="IntervalBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Session-Warnschwellen (%)" VerticalAlignment="Center" />
                    <TextBox x:Name="SessionWarnBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wochen-Warnschwellen (%)" VerticalAlignment="Center" />
                    <TextBox x:Name="WeekWarnBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Zustandsgrenzen (%)" VerticalAlignment="Center"
                               ToolTip="normal, aufmerksam, nervös, besorgt, Panik, schlafen" />
                    <TextBox x:Name="MoodThresholdsBox" Grid.Column="1"
                             ToolTip="normal, aufmerksam, nervös, besorgt, Panik, schlafen" />
                </Grid>
                <TextBlock Text="Reihenfolge: normal, aufmerksam, nervös, besorgt, Panik, schlafen"
                           Style="{StaticResource Hint}" Margin="0,0,0,4" />
                <CheckBox x:Name="ForecastBox" Content="Prognose anzeigen" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="SPRECHBLASEN &amp; BENACHRICHTIGUNGEN">
            <StackPanel>
                <CheckBox x:Name="BubblesBox" Content="Sprechblasen anzeigen" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Anzeigedauer (s)" VerticalAlignment="Center" />
                    <TextBox x:Name="BubbleDurationBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Dein Name" VerticalAlignment="Center" />
                    <TextBox x:Name="NameBox" Grid.Column="1" />
                </Grid>
                <CheckBox x:Name="NotificationsBox" Content="Windows-Benachrichtigungen" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Texte bearbeiten…" Padding="10,3" Click="EditTexts_Click"
                            ToolTip="Öffnet settings.json; Änderungen werden automatisch übernommen." />
                    <Button Content="Test-Benachrichtigung" Padding="10,3" Margin="8,0,0,0" Click="TestNotification_Click" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

    </StackPanel>
    </ScrollViewer>
    </DockPanel>
        </Border>
    </Grid>
</Window>
