<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK projections for the Store version's startup task (Windows.ApplicationModel.StartupTask). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudePet</AssemblyName>
    <RootNamespace>ClaudePet</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness is declared in app.manifest for WPF; the WinForms analyzer warning does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Releases pass -p:Version from the tag (build.ps1); self-built copies are 0.0.0 and skip update checks. -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share many type names; WinForms is only used for the tray icon. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UsageData.cs" Link="Shared\UsageData.cs" />
    <Compile Include="..\Shared\SessionData.cs" Link="Shared\SessionData.cs" />
  </ItemGroup>

  <!--
    Debug builds: build the bridge first and put it next to the app, so a self-built pet finds
    ClaudePetBridge.exe for the statusLine and the ?/! hooks. Releases publish both via build.ps1.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\ClaudePet.Bridge\ClaudePet.Bridge.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyBridge" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <BridgeFiles Include="..\ClaudePet.Bridge\bin\$(Configuration)\net8.0\ClaudePetBridge.exe;..\ClaudePet.Bridge\bin\$(Configuration)\net8.0\ClaudePetBridge.dll;..\ClaudePet.Bridge\bin\$(Configuration)\net8.0\ClaudePetBridge.deps.json;..\ClaudePet.Bridge\bin\$(Configuration)\net8.0\ClaudePetBridge.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
