<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudePet</AssemblyName>
    <RootNamespace>ClaudePet</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness is declared in app.manifest for WPF; the WinForms analyzer warning does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share many type names; WinForms is only used for the tray icon. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UsageData.cs" Link="Shared\UsageData.cs" />
  </ItemGroup>

</Project>
