<Window x:Class="Claudius.Pet.GhostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claudius Ghost"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Topmost="True"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight">
    <Image x:Name="GhostImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
</Window>
