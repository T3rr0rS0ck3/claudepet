<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudePetBridge</AssemblyName>
    <RootNamespace>ClaudePet.Bridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UsageData.cs" Link="Shared\UsageData.cs" />
    <Compile Include="..\Shared\SessionData.cs" Link="Shared\SessionData.cs" />
  </ItemGroup>

</Project>
