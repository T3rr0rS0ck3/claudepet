<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the release workflow.
  Paste this into the SignPath project (Artifact configurations → default).
  The artifact is the zip created by actions/upload-artifact with:
    ClaudePet-Setup-<version>.exe   installer
    ClaudePet/                      app files used for the portable zip
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ClaudePet-Setup-*.exe">
      <authenticode-sign />
    </pe-file>
    <directory path="ClaudePet">
      <pe-file-set>
        <include path="ClaudePet.exe" />
        <include path="ClaudePet.dll" />
        <include path="ClaudePetBridge.exe" />
        <include path="ClaudePetBridge.dll" />
        <for-each>
          <authenticode-sign />
        </for-each>
      </pe-file-set>
    </directory>
  </zip-file>
</artifact-configuration>
