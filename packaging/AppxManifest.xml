<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store version. packaging/build-msix.ps1 fills in {VERSION} (X.Y.Z.0).
  Identity and publisher come from Partner Center → Product identity and must match it exactly.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="T3rr0rS0ck3.Claudius-KIUsagePet"
    Publisher="CN=5F1DB1A2-9D29-497D-AE3A-2DDDF788C6E5"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Claudius - KI Usage Pet</DisplayName>
    <PublisherDisplayName>T3rr0rS0ck3</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="de-DE" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Claudius" Executable="Claudius.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Claudius - KI Usage Pet"
        Description="Desktop pet that shows your AI assistant usage"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Mit Windows starten": switched on and off by the app (Core/Autostart.cs). -->
        <desktop:Extension Category="windows.startupTask" Executable="Claudius.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ClaudiusStartup" Enabled="false" DisplayName="Claudius - KI Usage Pet" />
        </desktop:Extension>
        <!--
          The AI assistant runs the bridge for its statusLine and hooks. The install folder changes with every
          update and is closed to other programs, so the bridge gets a stable alias in
          %LOCALAPPDATA%\Microsoft\WindowsApps. It hangs off the main app: the Store rejects a second
          app without UI (AppListEntry="none").
        -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="ClaudiusBridge.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="ClaudiusBridge.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
